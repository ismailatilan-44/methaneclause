# Operator file: copy to .env and fill in yourself. Never commit .env. Nothing here is needed for `make demo` or
# `make judge-local` (local Anvil), and judges need none of it (scripts/judge.sh only reads JUDGE_PK).
# Ethereum Sepolia (chainId 11155111) is the live deployment (make deploy-sepolia); Base Sepolia (84532) also works
# (make deploy-base). Read by contracts/script/Deploy.s.sol:
SEPOLIA_RPC_URL=               # e.g. https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=          # e.g. https://sepolia.base.org
PRIVATE_KEY_DEPLOYER=          # 0x-prefixed; temporary registry admin, renounced at the end of the script
DEPLOYER_ADDR=
SELLER_ADDR=                   # [SIM] seller key (address)
BUYER_ADDR=                    # [SIM] buyer key (address)
OBSERVER_A_ADDR=
OBSERVER_B_ADDR=
OBSERVER_C_ADDR=
# optional: OBSERVER_{A,B,C}_PQ_HASH (bytes32, registers algId 2 = ECDSA + ML-DSA-44), PROPOSER_BOND_WEI,
# CHALLENGER_BOND_WEI, RENOUNCE_ADMIN (default true)
# Operator's testnet run (make testnet-run / testnet-finalize, pipeline/observer/testnet.py):
SELLER_PK=                     # [SIM] seller: creates and funds the covenant
BUYER_PK=                      # [SIM] buyer: finalizes and withdraws the rebate
PROPOSER_PK=                   # submits episodes (any address; pays the proposer bond)
PROPOSER_ADDR=
# Observer services on a public chain (pipeline/observer/service.py; the Anvil test keys are refused off-Anvil):
OBSERVER_A_PK=
OBSERVER_B_PK=
OBSERVER_C_PK=
RPC_URL=                       # chain the observer CLI talks to (default http://127.0.0.1:8545)
ETHERSCAN_API_KEY=             # Etherscan API v2 key (one key covers Sepolia and Base Sepolia verification)
